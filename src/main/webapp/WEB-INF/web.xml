<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    version="4.0">
    <display-name>Archetype Created Web Application</display-name>
    <welcome-file-list>
        <welcome-file>myPage</welcome-file>
    </welcome-file-list>
    <servlet>
        <servlet-name>FirstServlet</servlet-name>
        <servlet-class>com.exemplo.hello.first.FirstServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FirstServlet</servlet-name>
        <url-pattern>/myPage</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FirstGenericServlet</servlet-name>
        <servlet-class>com.exemplo.hello.first.FirstGenericServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FirstGenericServlet</servlet-name>
        <url-pattern>/myGeneric</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FirstHttpServlet</servlet-name>
        <servlet-class>com.exemplo.hello.first.FirstHttpServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FirstHttpServlet</servlet-name>
        <url-pattern>/myHttpServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>FeedbackServlet</display-name>
        <servlet-name>FeedbackServlet</servlet-name>
        <servlet-class>com.exemplo.hello.servlets.FeedbackServlet</servlet-class>
        <init-param>
            <description>Organization Email</description>
            <param-name>company-email</param-name>
            <param-value>jeecourse@hotmail.com</param-value>
        </init-param>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeedbackServlet</servlet-name>
        <url-pattern>/feedbackServlet</url-pattern>
    </servlet-mapping>

    <context-param>
        <param-name>db-ip</param-name>
        <param-value>127.0.0.1</param-value>
    </context-param>
    <context-param>
        <param-name>db-port</param-name>
        <param-value>3306</param-value>
    </context-param>

    <servlet>
        <display-name>ContextParamExample</display-name>
        <servlet-name>ContextParamExample</servlet-name>
        <servlet-class>com.exemplo.hello.servlets.scopes.ContextParamExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContextParamExample</servlet-name>
        <url-pattern>/ContextParamExample</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ApplicationScopeExample</display-name>
        <servlet-name>ApplicationScopeExample</servlet-name>
        <servlet-class>com.exemplo.hello.servlets.scopes.ApplicationScopeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationScopeExample</servlet-name>
        <url-pattern>/ApplicationScopeExample</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ApplicationScopeExample2</display-name>
        <servlet-name>ApplicationScopeExample2</servlet-name>
        <servlet-class>com.exemplo.hello.servlets.scopes.ApplicationScopeServlet2</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationScopeExample2</servlet-name>
        <url-pattern>/ApplicationScopeExample2</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>SessionScopeExample</display-name>
        <servlet-name>SessionScopeExample</servlet-name>
        <servlet-class>com.exemplo.hello.servlets.scopes.session.SessionScopeExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SessionScopeExample</servlet-name>
        <url-pattern>/isVisited</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>HttpServletRequestExample</display-name>
        <servlet-name>HttpServletRequestExample</servlet-name>
        <servlet-class>com.exemplo.hello.httprequest.example.HttpServletRequestExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HttpServletRequestExample</servlet-name>
        <url-pattern>/testRequest</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ResponseHeaderExample</display-name>
        <servlet-name>ResponseHeaderExample</servlet-name>
        <servlet-class>com.exemplo.hello.httpservletresponse.ResponseHeaderExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResponseHeaderExample</servlet-name>
        <url-pattern>/refreshHeaderExample</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>BinaryStreamExample</display-name>
        <servlet-name>BinaryStreamExample</servlet-name>
        <servlet-class>com.exemplo.hello.httpservletresponse.BinaryStreamExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BinaryStreamExample</servlet-name>
        <url-pattern>/showImageFile</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ErrorHandling</display-name>
        <servlet-name>ErrorHandling</servlet-name>
        <servlet-class>com.exemplo.hello.errorhandling.servlets.ErrorHandling</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ErrorHandling</servlet-name>
        <url-pattern>/ErrorHandling</url-pattern>
    </servlet-mapping>

    <error-page>
        <exception-type>com.exemplo.hello.exception.MyException</exception-type>
        <location>/myExceptionErrorPage.jsp</location>
    </error-page>

    <error-page>
        <error-code>404</error-code>
        <location>/pageNotFound.jsp</location>
    </error-page>

    <servlet>
        <display-name>IncludeExample</display-name>
        <servlet-name>IncludeExample</servlet-name>
        <servlet-class>com.exemplo.hello.includeforwardexample.servlets.IncludeExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncludeExample</servlet-name>
        <url-pattern>/IncludeExample</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>IncludeExample1</display-name>
        <servlet-name>IncludeExample1</servlet-name>
        <servlet-class>com.exemplo.hello.includeforwardexample.servlets.IncludeExample1</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncludeExample1</servlet-name>
        <url-pattern>/IncludeExample1</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ForwardExample</display-name>
        <servlet-name>ForwardExample</servlet-name>
        <servlet-class>com.exemplo.hello.includeforwardexample.servlets.ForwardExample</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForwardExample</servlet-name>
        <url-pattern>/ForwardExample</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>ForwardExample1</display-name>
        <servlet-name>ForwardExample1</servlet-name>
        <servlet-class>com.exemplo.hello.includeforwardexample.servlets.ForwardExample1</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForwardExample1</servlet-name>
        <url-pattern>/ForwardExample1</url-pattern>
    </servlet-mapping>

    <servlet>
        <display-name>SendRedirect</display-name>
        <servlet-name>SendRedirect</servlet-name>
        <servlet-class>com.exemplo.hello.sendredirectexample.servlets.SendRedirect</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SendRedirect</servlet-name>
        <url-pattern>/SendRedirect</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>MyFilter</filter-name>
        <filter-class>com.exemplo.hello.servletfilterexample.filters.MyFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>MyFilter</filter-name>
        <!-- <url-pattern>/MyServlet</url-pattern> -->
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <display-name>MyServlet</display-name>
        <servlet-name>MyServlet</servlet-name>
        <servlet-class>com.exemplo.hello.servletfilterexample.servlets.MyServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>MyServlet</servlet-name>
        <url-pattern>/MyServlet</url-pattern>
    </servlet-mapping>
</web-app>